generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Place {
  id                 String               @id @default(uuid())
  slug               String               @unique
  name               String
  address            String?
  googleMapUrl       String?
  ownerId            String?
  operationMode      OperationMode        @default(RESERVATION_ONLY)
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  eventDays          EventDay[]
  sessions           ParkingSession[]
  Payment            Payment[]
  Payout             Payout[]
  owner              Owner?               @relation(fields: [ownerId], references: [id])
  PlaceAssignment    PlaceAssignment[]
  PlaceBillingPolicy PlaceBillingPolicy[]
  pricingRules       PricingRule[]
  reservations       Reservation[]
  Settlement         Settlement[]
  spots              Spot[]
  spotModeCalendars  SpotModeCalendar[]
  events             Event[]
  monthlyContracts   MonthlyContract[]

  @@index([ownerId])
  @@index([operationMode])
}

model Spot {
  id                    String             @id @default(uuid())
  placeId               String
  code                  String
  label                 String?
  operationModeOverride OperationMode?
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  sessions              ParkingSession[]
  Payment               Payment[]
  reservations          Reservation[]
  place                 Place              @relation(fields: [placeId], references: [id])
  spotModeCalendars     SpotModeCalendar[]
  monthlyContracts      MonthlyContract[]

  @@unique([placeId, code])
  @@index([placeId])
  @@index([operationModeOverride])
}

model SpotModeCalendar {
  id            String        @id @default(uuid())
  placeId       String
  spotId        String
  date          String
  operationMode OperationMode
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  place         Place         @relation(fields: [placeId], references: [id])
  spot          Spot          @relation(fields: [spotId], references: [id])

  @@unique([spotId, date])
  @@index([placeId, date])
  @@index([spotId])
  @@index([date])
}

model Reservation {
  id                String            @id @default(uuid())
  date              String
  slot              String
  name              String
  plate             String
  price             Int
  qrToken           String            @unique @default(uuid())
  createdAt         DateTime          @default(now())
  checkedIn         Boolean           @default(false)
  checkedInAt       DateTime?
  checkedOutAt      DateTime?
  email             String?
  phone             String?
  paid              Boolean           @default(false)
  paidAt            DateTime?
  paymentRef        String?
  pin               String
  pinHash           String?
  placeId           String?
  spotId            String?
  cancelRequestedAt DateTime?
  cancelToken       String?           @unique
  canceledAt        DateTime?
  refundAmount      Int?
  refundStatus      RefundStatus      @default(NONE)
  status            ReservationStatus @default(CONFIRMED)
  reservationType   ReservationType   @default(general)
  busPartnerId      String?
  vehicleType       VehicleType?
  hasExtraCar       Boolean           @default(false)
  eventName         String?
  arrivalTime       String?
  note              String?
  sessions          ParkingSession[]
  Payment           Payment[]
  receipts          Receipt[]
  place             Place?            @relation(fields: [placeId], references: [id])
  spot              Spot?             @relation(fields: [spotId], references: [id])
  busPartner        BusPartner?       @relation(fields: [busPartnerId], references: [id])
  changeLogs        ReservationChangeLog[]

  @@index([placeId])
  @@index([spotId])
  @@index([date, slot])
  @@index([cancelToken])
  @@index([paymentRef])
  @@index([placeId, date, status])
  @@index([spotId, date, status])
  @@index([status])
  @@index([reservationType])
  @@index([busPartnerId])
  @@index([reservationType, date])
}

model ParkingSession {
  id            String        @id @default(uuid())
  placeId       String
  spotId        String
  reservationId String?
  sessionType   SessionType
  plate         String?
  phone         String?
  customerName  String?
  checkInAt     DateTime      @default(now())
  checkOutAt    DateTime?
  totalMinutes  Int?
  totalYen      Int?
  paid          Boolean       @default(false)
  paidAt        DateTime?
  paymentRef    String?
  status        SessionStatus @default(IN)
  createdAt     DateTime      @default(now())
  place         Place         @relation(fields: [placeId], references: [id])
  reservation   Reservation?  @relation(fields: [reservationId], references: [id])
  spot          Spot          @relation(fields: [spotId], references: [id])
  Payment       Payment[]

  @@index([placeId])
  @@index([spotId])
  @@index([reservationId])
  @@index([status])
}

model AdminUser {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  name             String?
  sessionToken     String?   @unique
  sessionExpiresAt DateTime?
  createdAt        DateTime  @default(now())

  @@index([sessionExpiresAt])
}

model Owner {
  id                String            @id @default(uuid())
  name              String
  displayName       String?
  email             String            @unique
  passwordHash      String
  phone             String?
  status            OwnerStatus       @default(ACTIVE)
  businessType      BusinessType?
  registeredAt      DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now())
  postalCode        String?
  address1          String?
  address2          String?
  invoiceNo         String?
  contractStartDate DateTime?
  contractEndDate   DateTime?
  bankAccountName   String?
  bankName          String?
  bankBranchName    String?
  bankAccountType   String?
  bankAccountNo     String?
  notes             String?
  sessionToken      String?
  sessionExpiresAt  DateTime?
  stripeAccountId          String?
  stripeOnboardingComplete Boolean           @default(false)
  Payment           Payment[]
  Payout            Payout[]
  places            Place[]
  PlaceAssignment   PlaceAssignment[]
  Settlement        Settlement[]

  @@index([registeredAt])
  @@index([status])
}

model PricingCalendar {
  id         String   @id @default(uuid())
  targetDate DateTime @unique
  priceYen   Int
  label      String   @default("NORMAL")
  createdAt  DateTime @default(now())

  @@index([targetDate])
}

model PricingRule {
  id           String       @id @default(uuid())
  placeId      String
  pricingType  PricingType
  hourlyYen    Int?
  dailyYen     Int?
  fixedYen     Int?
  roundingType RoundingType @default(CEIL_HOUR)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  place        Place        @relation(fields: [placeId], references: [id])

  @@index([placeId])
  @@index([pricingType])
  @@index([isActive])
}

model EventDay {
  id                        String   @id @default(uuid())
  placeId                   String
  date                      DateTime
  label                     String?
  hourlyYenOverride         Int?
  dailyYenOverride          Int?
  fixedYenOverride          Int?
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now())
  busFixedYen               Int?
  reservationOpenDaysBefore Int      @default(0)
  place                     Place    @relation(fields: [placeId], references: [id])

  @@unique([placeId, date])
  @@index([placeId])
  @@index([date])
  @@index([isActive])
}

model Receipt {
  id                String       @id @default(cuid())
  receiptNo         String       @unique
  reservationId     String?
  paymentRef        String?
  paymentIntentId   String?
  issuedAt          DateTime
  useDate           String
  parkingName       String
  slot              String
  customerName      String?
  plate             String?
  subtotal          Int
  tax               Int
  total             Int
  taxRate           Float        @default(0.1)
  issuerName        String
  issuerInvoiceNo   String?
  invoiceStatus     String       @default("pending")
  receiptRequested  Boolean      @default(false)
  pdfUrl            String?
  pdfPath           String?
  version           Int          @default(1)
  originalReceiptId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  originalReceipt   Receipt?     @relation("ReceiptReissueChain", fields: [originalReceiptId], references: [id])
  reissues          Receipt[]    @relation("ReceiptReissueChain")
  reservation       Reservation? @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
  @@index([paymentRef])
  @@index([paymentIntentId])
  @@index([useDate])
  @@index([invoiceStatus])
  @@index([customerName])
  @@index([plate])
}

model Adjustment {
  id                  String           @id
  paymentId           String
  kind                AdjustmentKind
  status              AdjustmentStatus @default(CONFIRMED)
  recognizedDate      DateTime
  recognizedMonth     String
  grossDeltaAmount    Int              @default(0)
  ownerDeltaAmount    Int              @default(0)
  agentDeltaAmount    Int              @default(0)
  platformDeltaAmount Int              @default(0)
  reason              String
  note                String?
  createdBy           String?
  approvedBy          String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime
  settledAt           DateTime?
  Payment             Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  SettlementItem      SettlementItem[]

  @@index([kind])
  @@index([paymentId])
  @@index([recognizedMonth])
  @@index([status])
}

model Agent {
  id                  String            @id
  code                String            @unique
  name                String
  displayName         String?
  email               String?           @unique
  passwordHash        String?
  sessionToken        String?           @unique
  sessionExpiresAt    DateTime?
  phone               String?
  status              AgentStatus       @default(ACTIVE)
  defaultAgentRateBps Int               @default(500)
  registeredAt        DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime
  postalCode          String?
  address1            String?
  address2            String?
  invoiceNo           String?
  bankAccountName     String?
  bankName            String?
  bankBranchName      String?
  bankAccountType     String?
  bankAccountNo       String?
  notes               String?
  stripeAccountId          String?
  stripeOnboardingComplete Boolean           @default(false)
  Payment             Payment[]
  Payout              Payout[]
  PlaceAssignment     PlaceAssignment[]
  Settlement          Settlement[]

  @@index([registeredAt])
  @@index([sessionExpiresAt])
  @@index([status])
}

model Payment {
  id                     String           @id
  kind                   PaymentKind
  status                 PaymentStatus    @default(CONFIRMED)
  settlementLock         SettlementLock   @default(UNLOCKED)
  reservationId          String?
  parkingSessionId       String?
  paymentRef             String?
  paymentIntentId        String?
  checkoutSessionId      String?
  stripeChargeId         String?
  placeId                String
  spotId                 String?
  ownerId                String
  agentId                String?
  placeNameSnapshot      String
  spotCodeSnapshot       String?
  spotLabelSnapshot      String?
  ownerNameSnapshot      String
  agentNameSnapshot      String?
  recognizedDate         DateTime
  recognizedMonth        String
  serviceDate            String?
  eventDate              DateTime?
  checkedOutAt           DateTime?
  customerNameSnapshot   String?
  plateSnapshot          String?
  currency               String           @default("JPY")
  grossAmount            Int
  ownerRateBps           Int
  agentRateBps           Int
  platformRateBps        Int
  ownerAmount            Int
  agentAmount            Int
  platformAmount         Int
  stripeFeeAmount        Int              @default(0)
  connectFeeAmount       Int              @default(0)
  payoutFeeAmount        Int              @default(0)
  freeOfCharge           Boolean          @default(false)
  manualAdjustment       Boolean          @default(false)
  refunded               Boolean          @default(false)
  dispute                Boolean          @default(false)
  excludedFromSettlement Boolean          @default(false)
  adjustmentReason       String?
  memo                   String?
  confirmedAt            DateTime         @default(now())
  settledAt              DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime
  Adjustment             Adjustment[]
  Agent                  Agent?           @relation(fields: [agentId], references: [id])
  Owner                  Owner            @relation(fields: [ownerId], references: [id])
  ParkingSession         ParkingSession?  @relation(fields: [parkingSessionId], references: [id])
  Place                  Place            @relation(fields: [placeId], references: [id])
  Reservation            Reservation?     @relation(fields: [reservationId], references: [id])
  Spot                   Spot?            @relation(fields: [spotId], references: [id])
  SettlementItem         SettlementItem[]

  @@unique([reservationId, kind], map: "payment_unique_reservation_kind")
  @@unique([parkingSessionId, kind], map: "payment_unique_session_kind")
  @@index([agentId, recognizedMonth])
  @@index([excludedFromSettlement, status])
  @@index([ownerId, recognizedMonth])
  @@index([paymentIntentId])
  @@index([paymentRef])
  @@index([placeId, recognizedMonth])
  @@index([recognizedDate])
  @@index([recognizedMonth])
  @@index([status])
}

model Payout {
  id              String       @id
  settlementId    String
  placeId         String?
  ownerId         String
  agentId         String?
  payoutTarget    PayoutTarget
  status          PayoutStatus @default(PENDING)
  scheduledAmount Int
  payoutFeeAmount Int          @default(0)
  actualAmount    Int
  bankAccountName String?
  bankName        String?
  bankBranchName  String?
  bankAccountType String?
  bankAccountNo   String?
  transferRef     String?
  stripeTransferId String?
  executedAt      DateTime?
  approvedAt      DateTime?
  failedReason    String?
  note            String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  Agent           Agent?       @relation(fields: [agentId], references: [id])
  Owner           Owner        @relation(fields: [ownerId], references: [id])
  Place           Place?       @relation(fields: [placeId], references: [id])
  Settlement      Settlement   @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([ownerId])
  @@index([settlementId])
  @@index([status])
}

model PlaceAssignment {
  id              String       @id
  placeId         String
  ownerId         String
  agentId         String?
  contractType    ContractType @default(OWNER_AGENT_PLATFORM)
  ownerRateBps    Int
  agentRateBps    Int
  platformRateBps Int
  startsAt        DateTime
  endsAt          DateTime?
  isActive        Boolean      @default(true)
  note            String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  Agent           Agent?       @relation(fields: [agentId], references: [id])
  Owner           Owner        @relation(fields: [ownerId], references: [id])
  Place           Place        @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([endsAt])
  @@index([isActive])
  @@index([ownerId])
  @@index([placeId])
  @@index([startsAt])
}

model PlaceBillingPolicy {
  id                     String       @id
  placeId                String
  startMonth             String
  endMonth               String?
  contractType           ContractType @default(OWNER_AGENT_PLATFORM)
  taxRateBps             Int          @default(1000)
  monthlyMinFeeThreshold Int          @default(300)
  ownerPayoutFeeBurden   Boolean      @default(false)
  agentPayoutFeeBurden   Boolean      @default(false)
  note                   String?
  isActive               Boolean      @default(true)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime
  Place                  Place        @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([endMonth])
  @@index([isActive])
  @@index([placeId])
  @@index([startMonth])
}

model Settlement {
  id                      String           @id
  month                   String
  ownerId                 String
  agentId                 String?
  placeId                 String
  contractType            ContractType?
  taxRateBps              Int              @default(1000)
  status                  SettlementStatus @default(DRAFT)
  paymentCount            Int              @default(0)
  adjustmentCount         Int              @default(0)
  totalGrossAmount        Int              @default(0)
  totalNetAmount          Int              @default(0)
  totalTaxAmount          Int              @default(0)
  platformFeeNet          Int              @default(0)
  platformFeeTax          Int              @default(0)
  platformFeeGross        Int              @default(0)
  ownerPayoutAmount       Int              @default(0)
  totalOwnerAmount        Int              @default(0)
  totalAgentAmount        Int              @default(0)
  totalPlatformAmount     Int              @default(0)
  monthlyMinFeeThreshold  Int              @default(300)
  monthlyMinFeeAdjustment Int              @default(0)
  payoutFeeAmount         Int              @default(0)
  ownerPayoutFeeAmount    Int              @default(0)
  agentPayoutFeeAmount    Int              @default(0)
  finalOwnerPayoutAmount  Int              @default(0)
  finalAgentPayoutAmount  Int              @default(0)
  lockedAt                DateTime?
  approvedAt              DateTime?
  paidAt                  DateTime?
  note                    String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime
  Payout                  Payout[]
  Agent                   Agent?           @relation(fields: [agentId], references: [id])
  Owner                   Owner            @relation(fields: [ownerId], references: [id])
  Place                   Place            @relation(fields: [placeId], references: [id])
  SettlementItem          SettlementItem[]

  @@index([agentId, month])
  @@index([month])
  @@index([ownerId, month])
  @@index([placeId, month])
  @@index([status])
}

model SettlementItem {
  id             String             @id
  settlementId   String
  paymentId      String?
  adjustmentId   String?
  itemType       SettlementItemType
  grossAmount    Int                @default(0)
  ownerAmount    Int                @default(0)
  agentAmount    Int                @default(0)
  platformAmount Int                @default(0)
  createdAt      DateTime           @default(now())
  Adjustment     Adjustment?        @relation(fields: [adjustmentId], references: [id])
  Payment        Payment?           @relation(fields: [paymentId], references: [id])
  Settlement     Settlement         @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([adjustmentId])
  @@index([paymentId])
  @@index([settlementId])
}

model BusPartner {
  id           String   @id @default(uuid())
  name         String
  contact      String
  phone        String
  email        String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  address      String?
  companyPhone String?
  reservations Reservation[]

  @@index([isActive])
}

model ReservationChangeLog {
  id            String      @id @default(uuid())
  reservationId String
  oldDate       String
  newDate       String
  changedAt     DateTime    @default(now())
  changedBy     String      @default("customer")
  reason        String?
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
}

enum SessionType {
  RESERVATION
  HOURLY
}

enum SessionStatus {
  IN
  OUT
}

enum OperationMode {
  RESERVATION_ONLY
  HOURLY_ONLY
  RESERVATION_THEN_HOURLY
  CLOSED
  EVENT_ONLY
  MONTHLY
}

enum PricingType {
  RESERVATION_FIXED
  HOURLY
}

enum RoundingType {
  CEIL_HOUR
}

enum AdjustmentKind {
  REFUND_FULL
  REFUND_PARTIAL
  MINIMUM_FEE
  MANUAL
  DISPUTE
  REVERSAL
}

enum AdjustmentStatus {
  PENDING
  CONFIRMED
  SETTLED
  EXCLUDED
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BusinessType {
  INDIVIDUAL
  CORPORATION
}

enum ContractType {
  HQ_BULK
  OWNER_DIRECT
  OWNER_AGENT_PLATFORM
}

enum OwnerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PaymentKind {
  RESERVATION
  HOURLY
  EVENT
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REFUNDED
  SETTLED
  EXCLUDED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum PayoutTarget {
  OWNER
  AGENT
}

enum RefundStatus {
  NONE
  PENDING
  SUCCEEDED
  FAILED
  NOT_REQUIRED
}

enum ReservationStatus {
  CONFIRMED
  CANCELED
}

enum ReservationType {
  general
  bus
}

// ④-D 月極プラン2のイベント日「予約する/利用しない」回答ログ
model MonthlyEventResponse {
  id          String                     @id @default(uuid())
  contractId  String
  placeId     String
  spotId      String
  date        String // イベント日 YYYY-MM-DD(JST)
  status      MonthlyEventResponseStatus @default(NOTIFIED)
  notifiedAt  DateTime                   @default(now())
  respondedAt DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@unique([contractId, date])
  @@index([placeId, date])
}

enum MonthlyEventResponseStatus {
  NOTIFIED
  RESERVED
  DECLINED
  EXPIRED
}

enum VehicleType {
  bus
  car
}

enum SettlementItemType {
  PAYMENT
  ADJUSTMENT
}

enum SettlementLock {
  UNLOCKED
  LOCKED
}

enum SettlementStatus {
  DRAFT
  APPROVED
  LOCKED
  PAID
  CANCELLED
}

model Event {
  id String @id @default(cuid())

  title       String
  description String?
  venue       String
  category    String    @default("concert")
  startAt     DateTime
  endAt       DateTime?
  doorOpenAt  DateTime?
  showStartAt DateTime?

  sourceType  String  @default("manual")
  sourceUrl   String?
  sourcePdfId String?
  officialUrl String?

  competitorPrice Int?
  ourPrice        Int?

  bookingStartDays Int?
  bookingStartAt   DateTime?
  bookingStartTime String?   @default("10:00")

  status String @default("draft")

  snsSchedule Json?

  place   Place?  @relation(fields: [placeId], references: [id])
  placeId String?

  venueGroup   VenueGroup? @relation(fields: [venueGroupId], references: [id])
  venueGroupId String?

  snsPosts SnsPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startAt])
  @@index([placeId])
  @@index([venueGroupId])
  @@index([sourceType, status])
}

model SnsPost {
  id               String    @id @default(cuid())
  eventId          String
  phase            Int
  phaseLabel       String
  platform         String    @default("both")
  postText         String
  scheduledAt      DateTime?
  postedAt         DateTime?
  fbPostId         String?
  igPostId         String?
  triggerType      String    @default("scheduled")
  triggerCondition String?
  status           String    @default("draft")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([status])
  @@index([scheduledAt])
}

model SnsBroadcast {
  id        String    @id @default(cuid())
  caption   String
  imageUrl  String?
  toIg      Boolean   @default(true)
  toFb      Boolean   @default(true)
  fbPostId  String?
  igPostId  String?
  status    String    @default("draft") // draft / posted / partial / failed
  error     String?
  postedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ScrapedPdf {
  id         String   @id @default(cuid())
  uafId      String   @unique
  title      String
  url        String
  scrapedAt  DateTime @default(now())
  eventCount Int      @default(0)
}

model VenueGroup {
  id       String              @id
  name     String
  events   Event[]
  parkings VenueGroupParking[]
}

model VenueGroupParking {
  id           String     @id @default(cuid())
  venueGroupId String
  parkingSlug  String
  showOnHp     Boolean    @default(true)
  venueGroup   VenueGroup @relation(fields: [venueGroupId], references: [id])

  @@index([venueGroupId])
  @@index([parkingSlug])
}

// 業務記録システム: 音声テキスト→構造化→Notion保存 の生ログ
model MemoLog {
  id        String   @id @default(cuid())
  category  String
  rawText   String
  parsed    Json?
  notionIds String[]
  createdAt DateTime @default(now())
}

// ===== 月極駐車場 (Monthly contract) =====

enum TenantStatus {
  ACTIVE
  INACTIVE
}

enum MonthlyContractPlan {
  NON_EVENT_ONLY   // プラン1: 非イベント日のみ
  INCLUDES_EVENT   // プラン2: イベント日も都度予約で駐車可
}

enum MonthlyContractBillingTerm {
  MONTHLY      // 月払い: Stripeサブスク(自動継続)
  QUARTERLY    // 3ヶ月一括前払い
  SEMIANNUAL   // 半年一括前払い
  ANNUAL       // 1年一括前払い(10%割引)
}

enum MonthlyContractStatus {
  PENDING          // 申込受付・承認待ち
  AWAITING_PAYMENT // 承認済・支払い登録待ち
  ACTIVE           // 契約有効
  PAST_DUE         // 支払い遅延
  CANCELED         // 解約
  REJECTED         // 申込却下
}

model Tenant {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String?           // bcrypt。契約成立時に発行
  name             String
  phone            String
  postalCode       String?
  address          String
  status           TenantStatus      @default(ACTIVE)
  sessionToken     String?           @unique
  sessionExpiresAt DateTime?
  stripeCustomerId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  contracts        MonthlyContract[]
  subscriptionPayments MonthlySubscriptionPayment[]

  @@index([status])
  @@index([sessionExpiresAt])
}

model MonthlyContract {
  id                     String                     @id @default(cuid())
  tenantId               String
  placeId                String
  spotId                 String?
  plan                   MonthlyContractPlan        @default(NON_EVENT_ONLY)
  billingTerm            MonthlyContractBillingTerm @default(MONTHLY)
  baseFeeYen             Int                        @default(3300)  // 月額・税込
  prepaidMonths          Int                        @default(1)     // 1/3/6/12
  discountBps            Int                        @default(0)     // 12ヶ月=1000(10%)
  totalFeeYen            Int                        // 期間合計(割引適用後・税込)
  vehicleType            String                     // 車種
  plate                  String                     // ナンバー
  importantTermsAgreedAt DateTime?                  // 重要事項同意日時
  startDate              String?                    // JST 'YYYY-MM-DD'
  endDate                String?                    // 前払い満了日 JST 'YYYY-MM-DD'
  status                 MonthlyContractStatus      @default(PENDING)
  stripeSubscriptionId   String?                    // 月払い時
  stripeCheckoutSession  String?
  stripePaymentIntentId  String?                    // 前払い一括時
  approvedAt             DateTime?
  canceledAt             DateTime?
  cancelRequestedAt      DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  tenant                 Tenant                     @relation(fields: [tenantId], references: [id])
  place                  Place                      @relation(fields: [placeId], references: [id])
  spot                   Spot?                      @relation(fields: [spotId], references: [id])
  subscriptionPayments   MonthlySubscriptionPayment[]

  @@index([tenantId])
  @@index([placeId])
  @@index([status])
  @@index([startDate])
}

model MonthlySubscriptionPayment {
  id              String          @id @default(cuid())
  contractId      String
  tenantId        String
  billingPeriod   String          // 対象月 "2026-07"（JST基準）
  amountYen       Int             // 税込
  taxRate         Int             @default(10)
  receiptNumber   String          @unique // 適格請求書の連番
  stripeInvoiceId String?         @unique
  stripePaymentIntentId String?
  paidAt          DateTime
  createdAt       DateTime        @default(now())
  contract        MonthlyContract @relation(fields: [contractId], references: [id])
  tenant          Tenant          @relation(fields: [tenantId], references: [id])

  @@index([contractId])
  @@index([tenantId])
  @@index([billingPeriod])
}

enum EventMonthlyOfferStatus {
  WAITING               // 月極利用者の回答待ち（＝一般客の承認待ち）
  RELEASED              // 月極が「使わない」/無回答 → 申請者が決済可
  TENANT_TOOK           // 月極が「使う」 → 申請者は利用不可（決済済）
  TENANT_CHARGE_PENDING // 月極が「使う」→ 課金失敗、月極の支払い待ち（③・案B）
  PAID                  // 申請者の決済完了・予約確定
  EXPIRED               // 期限切れ
  CANCELED              // 取消
}

model EventMonthlyOffer {
  id                           String   @id @default(uuid())
  placeId                      String
  spotId                       String
  date                         String   // "YYYY-MM-DD"（Reservation.date と同形式）
  contractId                   String
  applicantName                String?
  applicantEmail               String?
  applicantPhone               String?
  applicantPlate               String?
  status                       EventMonthlyOfferStatus @default(WAITING)
  monthlyChargePaymentIntentId String?
  applicantCheckoutSession     String?
  applicantReservationId       String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  expiresAt                    DateTime?

  @@unique([spotId, date])   // 1区画×1日=1オファー（先着1人固定・次に回さない）
  @@index([placeId, date])
  @@index([status])
}
